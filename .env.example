# PostgreSQL connection for Docker Compose.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-for-local-development

# DMI API base URL; version, collection, and items paths are added by the app.
DMI_API_URL=https://opendataapi.dmi.dk

# Selected parameters; blank uses the application's selective defaults.
DMI_PARAMETER_IDS=temp_dry,humidity

# Herodot sensor API. Enable only after setting the secret token locally.
HERODOT_ENABLED=false
SENSOR_API_URL=https://herodot.spac.dk/api/v1/observations
SENSOR_API_TOKEN=

# pgAdmin login.
PGADMIN_USER_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me-for-local-development
