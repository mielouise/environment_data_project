# PostgreSQL connection used by the application and integration tests.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=environment_data
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-for-local-development

# DMI collections endpoint; observation and station item paths are built in code.
DMI_API_URL=https://opendataapi.dmi.dk/v2/metObs/collections

# Optional comma-separated DMI parameter IDs; blank uses the defaults below.
DMI_PARAMETER_IDS=temp_dry,humidity,wind_speed,precip_past1h

# Repeat interval in seconds; the Compose default is 300 seconds.
ETL_INTERVAL_SECONDS=300

# pgAdmin login.
PGADMIN_USER_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me-for-local-development
